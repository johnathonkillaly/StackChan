STACKCHAN_BRIDGE_HOST=127.0.0.1
STACKCHAN_BRIDGE_PORT=8000
STACKCHAN_BRIDGE_LOG_LEVEL=INFO
STACKCHAN_BRIDGE_SESSION_STALE_SECONDS=30
STACKCHAN_BRIDGE_COMPAT_ENABLED=true
STACKCHAN_BRIDGE_AGENT_MAX_ITERATIONS=3

LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=local-model
LM_STUDIO_API_KEY=lm-studio
LM_STUDIO_TIMEOUT_SECONDS=30

HOME_ASSISTANT_ENABLED=false
HOME_ASSISTANT_BASE_URL=http://127.0.0.1:8123
HOME_ASSISTANT_TOKEN=

ROVER_ENABLED=false
ROVER_SIMULATION_MODE=true
ROVER_RPC_SOCKET_PATH=/var/run/arduino-router.sock
ROVER_RPC_HOST=127.0.0.1
ROVER_RPC_PORT=50051
ROVER_RPC_TIMEOUT_SECONDS=2.0
ROVER_LOOP_INTERVAL_MS=500
ROVER_ADMIN_SOCKET=/tmp/stackchan-rover-admin.sock
ROVER_OBSERVATION_SEQUENCE=unknown,clear,blocked_left,blocked_right
